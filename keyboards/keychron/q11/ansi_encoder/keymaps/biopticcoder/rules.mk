ENCODER_MAP_ENABLE = yes
TAP_DANCE_ENABLE = no  # Tap-dance disabled - using standard keycodes
COMBO_ENABLE = no
EXTRAKEY_ENABLE = yes # Needed for Hyper and Meh
RGB_MATRIX_ENABLE = yes  # Enable RGB Matrix lighting
VIA_ENABLE = yes  # Enable VIA configurator support

# DIP switch support for Mac/Win layer switching
DIP_SWITCH_ENABLE = yes

# Optional settings for Mod-Tap behavior (uncomment one if desired)
IGNORE_MOD_TAP_INTERRUPT = yes
PERMISSIVE_HOLD = yes
TAPPING_TERM = 200 # Adjust tapping term if needed (milliseconds)

DYNAMIC_KEYMAP_LAYER_COUNT = 5  # Increase dynamic layer count to include NAV layer

# Chordal Hold: treat Mod-Tap hold when another key is pressed simultaneously
CHORDAL_HOLD = yes

ONE_SHOT_ENABLE = yes  # Enable One Shot Mod support
